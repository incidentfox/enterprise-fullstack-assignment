# Application
APP_NAME=IncidentFox
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incidentfox

# GitHub App Configuration
GITHUB_APP_ID=your_app_id_here
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Coolify Integration
COOLIFY_API_URL=https://your-coolify-instance.com
COOLIFY_API_TOKEN=your_coolify_api_token_here
COOLIFY_WEBHOOK_SECRET=your_coolify_webhook_secret_here

# LLM Configuration (Anthropic Claude - Required)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Claude Model Selection
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_OPUS_MODEL=claude-opus-4-5-20251101
USE_OPUS_FOR_COMPLEX=false
OPUS_CONFIDENCE_THRESHOLD=60

# Feature Flags
ENABLE_AUTO_FIX=false
MAX_PATCH_FILES=5

# Security
ALLOWED_FILE_PATTERNS=Dockerfile,docker-compose*.yml,.env.example,package*.json,requirements*.txt,*.config.js,*.config.ts,tsconfig.json,Makefile
